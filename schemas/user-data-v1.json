{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "lessonProgress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "lastActivityId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "grammarActivityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          },
          "completedExerciseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "lessonId",
          "lastActivityId",
          "grammarActivityIds",
          "completedExerciseIds",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "activityProgress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "visited",
              "completed",
              "skipped"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "activityId",
          "status",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "vocabularyProgress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vocabularyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "firstLearnedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mastery": {
            "type": "string",
            "enum": [
              "new",
              "learning",
              "familiar"
            ]
          },
          "difficult": {
            "type": "boolean"
          },
          "nextReviewAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "vocabularyId",
          "firstLearnedAt",
          "mastery",
          "difficult",
          "nextReviewAt"
        ],
        "additionalProperties": false
      }
    },
    "reviewHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "vocabularyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "rating": {
            "type": "string",
            "enum": [
              "again",
              "hard",
              "good",
              "easy"
            ]
          }
        },
        "required": [
          "id",
          "vocabularyId",
          "reviewedAt",
          "rating"
        ],
        "additionalProperties": false
      }
    },
    "exerciseAttempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "exerciseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "attemptedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "self-check",
              "interactive"
            ]
          },
          "response": {
            "type": "string"
          },
          "revealed": {
            "type": "boolean"
          },
          "selfAssessment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "correct",
                  "incorrect"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "hintLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "id",
          "exerciseId",
          "attemptedAt",
          "mode",
          "response",
          "revealed",
          "selfAssessment",
          "hintLevel"
        ],
        "additionalProperties": false
      }
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "vocabulary",
              "activity"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "targetId",
          "kind",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "const": "en"
        },
        "voiceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "speechRate": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2
        },
        "newWordBatch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "dailyReviewLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "exerciseMode": {
          "type": "string",
          "enum": [
            "self-check",
            "interactive"
          ]
        },
        "reducedMotion": {
          "type": "boolean"
        }
      },
      "required": [
        "locale",
        "voiceId",
        "speechRate",
        "newWordBatch",
        "dailyReviewLimit",
        "exerciseMode",
        "reducedMotion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "exportedAt",
    "lessonProgress",
    "activityProgress",
    "vocabularyProgress",
    "reviewHistory",
    "exerciseAttempts",
    "bookmarks",
    "preferences"
  ],
  "additionalProperties": false
}
